{
  "name": "voicetutor-backend",
  "version": "1.0.0",
  "description": "VoiceTutor AI Backend — Node.js + Express + TypeScript",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "migrate": "node -e \"require('./dist/config/db').runMigrations()\""
  },
  "dependencies": {
    "@azure/ai-voicelive": "^1.0.0-alpha.20251117.2",
    "@azure/core-auth": "^1.10.1",
    "@azure/identity": "^4.13.1",
    "@azure/openai": "^1.0.0-beta.12",
    "@pinecone-database/pinecone": "^2.2.2",
    "axios": "^1.6.8",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-validator": "^7.0.1",
    "form-data": "^4.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "openai": "^4.40.0",
    "pg": "^8.11.5",
    "uuid": "^9.0.1",
    "ws": "^8.17.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.12.7",
    "@types/pg": "^8.11.5",
    "@types/uuid": "^9.0.8",
    "@types/ws": "^8.5.10",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
