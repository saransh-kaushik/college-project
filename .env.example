# ─── Azure VoiceLive (Realtime) ─────────────────────────────────────────────
# VoiceLive can run on EITHER an Azure OpenAI resource OR an Azure AI Services
# (Cognitive Services) resource. Set the VOICELIVE_* overrides only when your
# VoiceLive deployment lives on a different resource than AZURE_OPENAI_*.
# If they share the same resource, leave AZURE_VOICELIVE_* unset — the
# backend will fall back to AZURE_OPENAI_ENDPOINT / AZURE_OPENAI_API_KEY.

# Option A — Azure OpenAI resource  (endpoint ends in .openai.azure.com)
# Leave AZURE_VOICELIVE_ENDPOINT unset; set AZURE_VOICELIVE_MODEL below.

# Option B — Azure AI Services resource  (endpoint ends in .cognitiveservices.azure.com)
# AZURE_VOICELIVE_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
# AZURE_VOICELIVE_API_KEY=your_cognitive_services_key_here

# Model must be a gpt-4o-realtime-preview deployment in your Azure resource
AZURE_VOICELIVE_MODEL=gpt-4o-realtime-preview

# Voice name — must be a valid Azure Neural voice for type 'azure-standard'.
# ⚠️  OpenAI voices (shimmer, alloy, ash, etc.) are NOT valid here and will
#     cause a "not a valid azure-standard voice" error from Azure.
# Valid examples: en-US-Ava:DragonHDLatestNeural | en-US-JennyMultilingualNeural
#                 en-US-AvaMultilingualNeural | en-US-AndrewNeural
AZURE_VOICELIVE_VOICE=en-US-Ava:DragonHDLatestNeural


# ─── Azure Speech (legacy STT pipeline — not used by VoiceLive) ─────────────
AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=eastus


# ─── Azure OpenAI ────────────────────────────────────────────────────────────
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_API_VERSION=2024-02-01


# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d


# ─── PostgreSQL ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/voicetutor


# ─── Pinecone ────────────────────────────────────────────────────────────────
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX=voicetutor-kb


# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173
